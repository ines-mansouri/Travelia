# Amadeus Self-Service API Credentials
# Sign up: https://developers.amadeus.com → "Flight Offers Search"
AMADEUS_API_KEY=your_api_key_here
AMADEUS_API_SECRET=your_api_secret_here

# Affiliate Partner ID (for commission tracking)
AFFILIATE_PARTNER_ID=your_partner_id

# Laravel backend URL for click tracking
LARAVEL_TRACKING_URL=http://127.0.0.1:8000/api/v1/tracking/click
